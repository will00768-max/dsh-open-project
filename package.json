{
  "name": "dsh-open-project",
  "version": "0.1.11",
  "description": "Open the current project folder from the conversation header with a detected editor or terminal, or from the workspace menu in the file manager.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/will00768-max/dsh-open-project.git"
  },
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "docs",
    "README.md",
    "README.zh.md",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "plugin",
    "deepseek-harness",
    "open-with",
    "editor",
    "vscode",
    "zed",
    "datagrip",
    "terminal"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --check src/index.js && node --check src/client.js"
  }
}
